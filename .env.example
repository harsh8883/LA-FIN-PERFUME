# ============================================================
# LA FIN Luxury Perfumes - Environment Configuration Template
# Copy this file to .env and configure your production secrets.
# ============================================================

# Server Port (default: 3000)
PORT=3000

# JSON Web Token Secret (generate a strong, cryptographically random key)
JWT_SECRET=replace_with_a_long_secure_random_secret_min_32_chars

# Master Store Administrator Credentials (read server-side only)
ADMIN_EMAIL=admin@lafin.luxury
ADMIN_PASSWORD=replace_with_a_strong_production_password
ADMIN_NAME=Store Administrator

